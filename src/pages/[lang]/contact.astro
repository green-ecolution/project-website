---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Hero from '../../components/Hero.astro'
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro'
import ContactHeroContent from '../../components/sections/ContactHeroContent.astro'
import Stakeholder from '../../components/sections/Stakeholder.astro'
import { getTranslations } from '../../i18n/t'
import { languagePaths } from '../../lib/languagePaths'
import { currentLanguage } from '../../i18n/languages'

export const getStaticPaths = languagePaths

const language = currentLanguage(Astro.params.lang)
const t = getTranslations(language, 'contact')
const tc = getTranslations(language, 'common')
---

<BaseLayout
  title={t('meta.title')}
  description={t('meta.description')}
  language={language}
  path="/contact"
>
  <BreadcrumbSchema
    language={language}
    items={[
      { name: tc('breadcrumb.home'), path: '' },
      { name: tc('breadcrumb.contact'), path: '/contact' },
    ]}
  />
  <main
    id="main-content"
    class="relative overflow-hidden before:bg-cover before:bg-background-dark-dot before:w-4/5 before:h-[100vh] before:max-h-[45rem] before:absolute before:-right-4 before:-top-16 before:-z-10 before:bg-no-repeat sm:before:-right-10 lg:before:max-h-[55rem] xl:before:w-[70rem] xl:before:-right-40 2xl:before:right-[10%] 2xl:before:bg-contain"
  >
    <Hero headline={t('hero.headline')} description={t('hero.description')} label={t('hero.label')}>
      <ContactHeroContent language={language} />
    </Hero>
    <Stakeholder language={language} hasDesktopList />
  </main>
</BaseLayout>
