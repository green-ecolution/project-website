---
import { getSectionRule, headingFromId } from '../../lib/sectionRules'

interface Props {
  id?: string
}

// MDX passes the heading id astro generated from the text, which is enough to
// resolve the rule. Without an id there is nothing to match on, so the fallback
// rule applies.
const { id } = Astro.props
const { icon: Icon, tone } = getSectionRule(headingFromId(id ?? ''))
---

<div class="flex items-center gap-3 mt-10 mb-4 first:mt-0" id={id}>
  <span
    class:list={[
      'inline-flex items-center justify-center w-8 h-8 rounded-lg flex-shrink-0',
      tone === 'brand' ? 'bg-green-dark-900 text-white' : 'bg-grey-900/10 text-grey-900/60',
    ]}
  >
    <Icon className="w-4 h-4" aria-hidden="true" />
  </span>
  <h2 class="font-lato font-bold text-xl lg:text-2xl text-grey-900">
    <slot />
  </h2>
</div>
