---
interface Props {
  href: string
  ariaLabel: string
  isExternalLink?: boolean
  isDark?: boolean
}

// The caller passes a finished path. Without a router there is no reason for
// this building block to know about languages.
const { href, ariaLabel, isExternalLink = false, isDark = false } = Astro.props

const baseClasses =
  'flex items-center justify-center gap-x-4 rounded-2xl w-max font-semibold px-5 py-2 group cursor-pointer transition-all ease-in-out duration-300 text-white'

const darkClasses =
  'bg-green-dark-900 hover:bg-green-light-900 hover:shadow-lg hover:shadow-green-light-900/40 hover:-translate-y-0.5'

const lightClasses =
  'bg-transparent border border-white hover:bg-green-light-900 hover:border-green-light-900 hover:shadow-lg hover:shadow-green-light-900/30'
---

<a
  href={href}
  aria-label={ariaLabel}
  target={isExternalLink ? '_blank' : undefined}
  rel={isExternalLink ? 'noopener noreferrer' : undefined}
  class:list={[baseClasses, isDark ? darkClasses : lightClasses]}
>
  <slot />
</a>
