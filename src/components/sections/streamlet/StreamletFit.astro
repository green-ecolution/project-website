---
import type { Language } from '../../../i18n/languages'
import { getTranslations } from '../../../i18n/t'
import { fitCriteria } from '../../../data/streamlet'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'streamlet')
---

<section
  class="px-4 max-w-208 mx-auto my-20 md:px-6 lg:my-28 lg:max-w-screen-lg xl:my-36 xl:max-w-screen-xl"
>
  <div class="mb-10 lg:mb-14 lg:text-center">
    <div class="inline-block mb-4">
      <span class="text-xs font-semibold tracking-widest text-green-light-900 uppercase">
        {t('fit.sectionLabel')}
      </span>
      <div class="h-0.5 w-12 bg-gradient-to-r from-green-light-900 to-transparent mt-1"></div>
    </div>

    <h2 class="font-lato font-bold text-2xl mb-4 text-grey-900 lg:text-3xl xl:text-4xl">
      {t('fit.title')}
    </h2>

    <p class="text-grey-900/70 leading-relaxed lg:max-w-2xl lg:mx-auto">{t('fit.description')}</p>
  </div>

  <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-5">
    {
      fitCriteria.map((criterion) => {
        const Icon = criterion.icon

        return (
          <li class="flex items-start gap-4 rounded-2xl border border-green-dark-900/10 bg-white p-5 transition-colors duration-300 hover:border-green-light-900/60">
            <span class="flex-shrink-0 w-10 h-10 rounded-lg bg-green-light-900/15 flex items-center justify-center">
              <Icon className="w-5 h-5 text-green-dark-900" aria-hidden="true" />
            </span>
            <span class="text-grey-900/80 leading-relaxed">
              {t(`fit.criteria.${criterion.id}`)}
            </span>
          </li>
        )
      })
    }
  </ul>

  <div class="mt-8 rounded-2xl bg-green-light-100/70 border border-green-light-900/20 p-6 lg:p-8">
    <h3 class="font-lato font-semibold text-grey-900 mb-2">{t('fit.cargo.title')}</h3>
    <p class="text-grey-900/70 leading-relaxed">{t('fit.cargo.description')}</p>
  </div>
</section>
