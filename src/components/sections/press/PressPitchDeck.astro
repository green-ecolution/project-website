---
import { ASSET_BASE_URL } from 'astro:env/server'
import { FileText } from 'lucide-react'
import PressSection from './PressSection.astro'
import type { Language } from '../../../i18n/languages'
import { getTranslations } from '../../../i18n/t'
import { PITCH_DECK_PATH, pressAssetUrl } from '../../../lib/pressKit'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = getTranslations(language, 'press')
---

<PressSection
  label={t('pitchDeck.sectionLabel')}
  title={t('pitchDeck.title')}
  description={t('pitchDeck.description')}
>
  <a
    href={pressAssetUrl(ASSET_BASE_URL, PITCH_DECK_PATH)}
    aria-label={t('pitchDeck.downloadAriaLabel')}
    class="group flex flex-col gap-6 rounded-2xl border border-green-dark-900/20 bg-green-light-100 p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-sm sm:flex-row sm:items-center sm:justify-between lg:p-8"
  >
    <span class="flex items-center gap-4 min-w-0">
      <span
        class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-dark-900/10 flex items-center justify-center transition-colors group-hover:bg-green-dark-900"
      >
        <FileText
          className="w-6 h-6 text-green-dark-900 transition-colors group-hover:text-white"
        />
      </span>
      <span class="min-w-0">
        <span class="block font-lato font-semibold text-lg text-grey-900">
          {t('pitchDeck.title')}
        </span>
        <span class="block text-grey-600 text-sm">{t('pitchDeck.fileLabel')}</span>
      </span>
    </span>

    <span
      class="flex-shrink-0 self-start rounded-2xl bg-green-dark-900 px-5 py-2.5 font-semibold text-white transition-all duration-300 group-hover:bg-green-light-900 sm:self-auto"
    >
      {t('pitchDeck.download')}
    </span>
  </a>
</PressSection>
