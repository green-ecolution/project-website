---
import { ARROW_PATH } from '../../lib/iconPaths'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  viewBox="0 0 24 24"
  stroke-width="1.5"
  stroke="currentColor"
  class={className}
>
  <path stroke-linecap="round" stroke-linejoin="round" d={ARROW_PATH}></path>
</svg>
