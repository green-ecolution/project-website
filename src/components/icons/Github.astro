---
import { GITHUB_PATH } from '../../lib/iconPaths'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  class={className}
>
  <path d={GITHUB_PATH}></path>
</svg>
