---
import type { Language } from '../i18n/languages'

interface Props {
  items: { name: string; path: string }[]
  language: Language
}

const BASE_URL = 'https://green-ecolution.de'

// Takes finished names, not catalog keys: the page already holds its own t.
const { items, language } = Astro.props

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: `${BASE_URL}/${language}${item.path}`,
  })),
}
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
